{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/et7admin/ai-agents-for-business/schemas/sop.schema.json",
  "title": "SOP frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "department", "version", "status", "owner", "raci", "trigger", "inputs", "outputs", "max_autonomy", "review_cycle", "last_reviewed"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2,3}-SOP-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "department": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "active", "retired"] },
    "owner": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Role ID accountable for keeping this SOP current." },
    "raci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsible", "accountable"],
      "properties": {
        "responsible": { "$ref": "#/$defs/roleList", "minItems": 1 },
        "accountable": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "consulted": { "$ref": "#/$defs/roleList" },
        "informed": { "$ref": "#/$defs/roleList" }
      }
    },
    "trigger": { "type": "string", "minLength": 5 },
    "frequency": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "kpis": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,3}-KPI-[0-9]{3}$" } },
    "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "related_sops": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,3}-SOP-[0-9]{3}$" } },
    "max_autonomy": { "enum": ["A0", "A1", "A2", "A3"] },
    "review_cycle": { "enum": ["monthly", "quarterly", "semiannual", "annual"] },
    "last_reviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "$defs": {
    "roleList": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true }
  }
}
