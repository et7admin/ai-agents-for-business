{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/et7admin/ai-agents-for-business/schemas/agent.schema.json",
  "title": "Role agent frontmatter (Claude Code subagent compatible)",
  "type": "object",
  "required": ["name", "description", "skills"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 40, "maxLength": 1024 },
    "skills": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "minItems": 1, "uniqueItems": true },
    "color": { "type": "string" }
  }
}
